{
  "title": "DevCircle Production SLO",
  "uid": "devcircle-slo",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "30d Availability",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "devcircle:gateway_availability:ratio30d", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.99,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "green", "value": 0.995 }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Services Up",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(up{job=\"devcircle\"})", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Gateway Request Rate",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 4 },
      "targets": [{ "expr": "devcircle:gateway_requests:rate5m", "legendFormat": "requests/s", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "Gateway P95 vs SLO",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 5 },
      "targets": [
        { "expr": "devcircle:gateway_read_p95_seconds:5m", "legendFormat": "read p95 (target 0.3s)", "refId": "A" },
        { "expr": "devcircle:gateway_write_p95_seconds:5m", "legendFormat": "write p95 (target 0.6s)", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Availability Error Budget Burn",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 5 },
      "targets": [
        { "expr": "devcircle:gateway_error_budget_burn:5m", "legendFormat": "5m", "refId": "A" },
        { "expr": "devcircle:gateway_error_budget_burn:1h", "legendFormat": "1h", "refId": "B" },
        { "expr": "devcircle:gateway_error_budget_burn:6h", "legendFormat": "6h", "refId": "C" },
        { "expr": "devcircle:gateway_error_budget_burn:3d", "legendFormat": "3d", "refId": "D" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox Fleet State",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 5 },
      "targets": [
        { "expr": "devcircle_outbox_fleet_backlog", "legendFormat": "backlog", "refId": "A" },
        { "expr": "devcircle_outbox_fleet_retryable", "legendFormat": "retryable", "refId": "B" },
        { "expr": "devcircle_outbox_fleet_dead", "legendFormat": "dead", "refId": "C" },
        { "expr": "devcircle_outbox_fleet_blocked", "legendFormat": "blocked", "refId": "D" }
      ]
    },
    {
      "type": "stat",
      "title": "Outbox Fleet Complete",
      "gridPos": { "x": 12, "y": 9, "w": 6, "h": 5 },
      "targets": [{ "expr": "devcircle_outbox_fleet_complete", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "JVM Heap Used",
      "gridPos": { "x": 18, "y": 9, "w": 6, "h": 5 },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (service)", "legendFormat": "{{service}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ]
}
