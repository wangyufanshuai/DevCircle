{
  "title": "DevCircle v1.0 Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "stat",
      "title": "Service Up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(up{job=\"devcircle\"})", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests",
      "gridPos": { "x": 6, "y": 0, "w": 9, "h": 4 },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (instance)", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "P95 Latency",
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, instance))", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "JVM Heap Used",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 5 },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (instance)", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "5xx Rate",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 5 },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) by (instance)", "refId": "A" }]
    }
  ]
}
