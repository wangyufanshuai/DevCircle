FROM eclipse-temurin:21-jre
ARG JAR_FILE
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system devcircle \
    && useradd --system --gid devcircle --home-dir /app devcircle
COPY ${JAR_FILE} app.jar
RUN chown -R devcircle:devcircle /app
USER devcircle
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
