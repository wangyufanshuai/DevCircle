ARG RUNTIME_IMAGE=eclipse-temurin:21-jre@sha256:273396ed5998598ed1091e8d72711c2d36980a0e65103859c55a4e977a41ffd3
FROM ${RUNTIME_IMAGE}
ARG JAR_FILE
WORKDIR /app
RUN groupadd --system devcircle \
    && useradd --system --gid devcircle --home-dir /app devcircle
COPY ${JAR_FILE} app.jar
RUN chown -R devcircle:devcircle /app
USER devcircle
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
