MYSQL_ROOT_PASSWORD=replace-with-random-root-password
REDIS_PASSWORD=replace-with-random-redis-password
MINIO_ROOT_USER=replace-with-random-minio-user
MINIO_ROOT_PASSWORD=replace-with-random-minio-password
DEVCIRCLE_JWT_SECRET=replace-with-at-least-64-random-characters

GITHUB_CLIENT_ID=
