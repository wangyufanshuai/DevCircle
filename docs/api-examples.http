@baseUrl = http://localhost:8080
@userToken = Bearer replace-with-real-access-token
@adminToken = Bearer replace-with-real-admin-access-token

### 密码登录
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "reader@example.com",
  "password": "replace-with-password"
}

### 刷新令牌
POST {{baseUrl}}/api/auth/refresh
X-CSRF-Token: replace-with-csrf-cookie-value

### 退出登录
POST {{baseUrl}}/api/auth/logout
X-CSRF-Token: replace-with-csrf-cookie-value

### 当前用户
GET {{baseUrl}}/api/auth/me
Authorization: {{adminToken}}

### GitHub OAuth2
GET {{baseUrl}}/api/auth/oauth2/github/start

### 混合推荐
GET {{baseUrl}}/api/recommend/feed?scene=mixed&size=6
Authorization: {{userToken}}

### 推理馆推荐
GET {{baseUrl}}/api/recommend/feed?scene=deduction&size=6
Authorization: {{userToken}}

### v1.3 推理馆分页加载
GET {{baseUrl}}/api/recommend/feed?scene=deduction&cursor=12&size=12
Authorization: {{userToken}}

### 科幻馆推荐
GET {{baseUrl}}/api/recommend/feed?scene=sci_fi&size=6
Authorization: {{userToken}}

### 宇宙档案推荐
GET {{baseUrl}}/api/recommend/feed?scene=cosmos&size=6
Authorization: {{userToken}}

### 推荐曝光
POST {{baseUrl}}/api/recommend/exposures
Authorization: {{userToken}}
Content-Type: application/json

{
  "userId": 2,
  "postIds": [1001, 1003],
  "scene": "deduction_feed"
}

### 主题帖子列表
GET {{baseUrl}}/api/posts?theme=DEDUCTION&contentKind=CASE_FILE&difficulty=HARD
Authorization: {{userToken}}

### v1.3 逻辑谜题筛选
GET {{baseUrl}}/api/posts?theme=DEDUCTION&contentKind=PUZZLE&page=1&size=20
Authorization: {{userToken}}

### 主题帖子详情
GET {{baseUrl}}/api/posts/1001
Authorization: {{userToken}}

### 相关内容召回
GET {{baseUrl}}/api/posts/1001/related?size=6
Authorization: {{userToken}}

### 创建推理案件
POST {{baseUrl}}/api/posts
Authorization: {{userToken}}
Content-Type: application/json

{
  "type": "TEXT",
  "theme": "DEDUCTION",
  "contentKind": "CASE_FILE",
  "difficulty": "HARD",
  "solvable": true,
  "title": "雾港钟楼失踪案",
  "content": "凌晨零点钟声响起后，守夜人从封闭钟楼消失。",
  "tags": ["密室", "时间线", "海港"],
  "clues": "怀表停在 00:07；鞋印只到楼梯口；航海日志缺了一页",
  "solution": "守夜人藏在钟楼夹层"
}

### 提交推理答案
POST {{baseUrl}}/api/deduction/cases/1001/answers
Authorization: {{userToken}}
Content-Type: application/json

{
  "answer": "凶手躲在钟楼夹层，并利用怀表制造时间差"
}

### 查看我的答题状态
GET {{baseUrl}}/api/deduction/cases/1001/attempts/me
Authorization: {{userToken}}

### 解谜排行榜
GET {{baseUrl}}/api/deduction/leaderboard
Authorization: {{userToken}}

### 主题搜索
GET {{baseUrl}}/api/search/posts?keyword=钟楼&theme=DEDUCTION&contentKind=CASE_FILE&difficulty=HARD
Authorization: {{userToken}}

### 上传媒体
POST {{baseUrl}}/api/files
Authorization: {{userToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="cover.png"
Content-Type: image/png

< ./cover.png
--boundary--

### 点赞，带幂等键
POST {{baseUrl}}/api/posts/1001/like
Authorization: {{userToken}}
Idempotency-Key: like-1001-demo

### 收藏，带幂等键
POST {{baseUrl}}/api/posts/1001/favorite
Authorization: {{userToken}}
Idempotency-Key: favorite-1001-demo

### 关注用户
POST {{baseUrl}}/api/users/42/follow
Authorization: {{userToken}}

### 重建搜索索引
POST {{baseUrl}}/api/search/admin/reindex
Authorization: {{adminToken}}

### 发布 Outbox 事件
POST {{baseUrl}}/api/content/admin/outbox/publish?batchSize=100
Authorization: {{adminToken}}

### 审核列表
GET {{baseUrl}}/api/admin/audits/posts
Authorization: {{adminToken}}

### 审核通过
POST {{baseUrl}}/api/admin/audits/posts/1001/approve
Authorization: {{adminToken}}

### 审计日志
GET {{baseUrl}}/api/admin/audit-logs?page=1&size=20
Authorization: {{adminToken}}

### v1.1 治理审核队列
GET {{baseUrl}}/api/admin/moderation/tasks?queue=manual-review&riskLevel=HIGH&status=PENDING&page=1&size=20
Authorization: {{adminToken}}

### v1.1 审核通过治理任务
POST {{baseUrl}}/api/admin/moderation/tasks/1/approve
Authorization: {{adminToken}}

### v1.1 审核驳回治理任务
POST {{baseUrl}}/api/admin/moderation/tasks/1/reject
Authorization: {{adminToken}}

### v1.1 升级复审
POST {{baseUrl}}/api/admin/moderation/tasks/1/escalate
Authorization: {{adminToken}}

### v1.1 要求修改
POST {{baseUrl}}/api/admin/moderation/tasks/1/require-changes
Authorization: {{adminToken}}

### v1.1 用户申诉
POST {{baseUrl}}/api/posts/1001/appeals
Authorization: {{userToken}}
Content-Type: application/json

{
  "reason": "我认为案件线索描述没有违反社区规则，请复审。"
}

### v1.1 申诉列表
GET {{baseUrl}}/api/admin/appeals?status=PENDING&page=1&size=20
Authorization: {{adminToken}}

### v1.1 风险用户列表
GET {{baseUrl}}/api/admin/risk/users?status=WATCH&page=1&size=20
Authorization: {{adminToken}}

### v1.1 风险用户画像
GET {{baseUrl}}/api/admin/risk/users/12/profile
Authorization: {{adminToken}}

### v1.1 限制用户
POST {{baseUrl}}/api/admin/risk/users/12/restrict?status=NO_POST
Authorization: {{adminToken}}
Idempotency-Key: risk-restrict-12-001
Content-Type: application/json

{
  "reason": "连续发布的内容来源无法核验，暂停投稿七天"
}

### v1.1 解除限制
POST {{baseUrl}}/api/admin/risk/users/12/unrestrict
Authorization: {{adminToken}}
Idempotency-Key: risk-unrestrict-12-001
Content-Type: application/json

{
  "reason": "复核完成，风险信号已解除"
}

### v1.1 推荐行为事件
POST {{baseUrl}}/api/recommend/events
Authorization: {{userToken}}
Content-Type: application/json

{
  "postId": 1001,
  "eventType": "detail_view",
  "scene": "deduction",
  "experimentId": "exp-theme-feed-v1",
  "bucket": "weighted",
  "requestId": "rest-client-demo-001"
}

### v1.1 推荐实验列表
GET {{baseUrl}}/api/admin/recommend/experiments
Authorization: {{adminToken}}

### v1.1 创建推荐实验
POST {{baseUrl}}/api/admin/recommend/experiments
Authorization: {{adminToken}}
Content-Type: application/json

{
  "experimentId": "exp-cosmos-depth-v1",
  "name": "宇宙档案阅读深度实验",
  "scene": "cosmos",
  "trafficPercent": 50,
  "weights": {
    "theme": 0.35,
    "hot": 0.2,
    "freshness": 0.2,
    "follow": 0.15,
    "series": 0.1
  }
}

### v1.1 激活推荐实验
POST {{baseUrl}}/api/admin/recommend/experiments/exp-cosmos-depth-v1/activate
Authorization: {{adminToken}}

### v1.1 暂停推荐实验
POST {{baseUrl}}/api/admin/recommend/experiments/exp-cosmos-depth-v1/pause
Authorization: {{adminToken}}

### v1.1 运营总览
GET {{baseUrl}}/api/admin/metrics/overview
Authorization: {{adminToken}}

### v1.1 主题运营指标
GET {{baseUrl}}/api/admin/metrics/themes
Authorization: {{adminToken}}

### v1.2 工程健康概览
GET {{baseUrl}}/api/admin/ops/health
Authorization: {{adminToken}}

### v1.2 Outbox 积压列表
GET {{baseUrl}}/api/admin/ops/outbox?status=NEW&page=1&size=20
Authorization: {{adminToken}}

### v1.2 按 topic 查看 Outbox
GET {{baseUrl}}/api/admin/ops/outbox?topic=post.created&page=1&size=20
Authorization: {{adminToken}}

### v1.2 重放 Outbox
POST {{baseUrl}}/api/admin/ops/outbox/replay?topic=post.created&batchSize=100
Authorization: {{adminToken}}

### v1.2 降级状态概览
GET {{baseUrl}}/api/admin/ops/degradation
Authorization: {{adminToken}}
